# Gemini API key for semantic proposal scoring and slide vision.
# Leave empty for offline runs: deck quality is still scored, and semantic
# scores are recorded as unavailable.
GEMINI_API_KEY=

# Model for slide vision (semantic scoring always uses gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# Aurochs checkout for PPTX slide rendering; run scripts/fetch_aurochs_renderer.sh first.
# AUROCHS_ROOT=vendor/aurochs

# Optional base cache directory (defaults to ~/.cache).
# XDG_CACHE_HOME=~/.cache

# Optional .NET OpenXML SDK validator command.
# OPENXML_VALIDATOR_COMMAND=
