# Gemini API Key for vision and semantic proposal scoring.
# If omitted, deterministic extraction and rubric scoring proceed,
# and semantic evaluation is explicitly recorded as unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Aurochs checkout root for PPTX slide rendering (defaults to vendor/aurochs).
# AUROCHS_ROOT=vendor/aurochs

# Optional base cache directory (defaults to ~/.cache).
# XDG_CACHE_HOME=~/.cache

# Optional .NET OpenXML SDK validator command.
# OPENXML_VALIDATOR_COMMAND=
