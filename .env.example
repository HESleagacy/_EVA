# Gemini API keys for vision and semantic proposal scoring.
# If omitted, deterministic extraction and rubric scoring proceed,
# and semantic evaluation is explicitly recorded as unavailable.
#
# GEMINI_API_KEYS accepts several keys separated by commas. They are tried in
# order: the pool stays on one key until it returns a quota (429), rate-limit,
# or authentication failure, then moves to the next one. A rate-limited key is
# retried after GEMINI_KEY_COOLDOWN_SECONDS; an invalid or forbidden key is
# dropped for the rest of the run.
GEMINI_API_KEYS=
# Single-key alternative; appended to the pool when both are set.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
# Semantic evaluation model. Defaults to gemini-2.5-flash, which newer API
# projects cannot call; supported values are gemini-2.5-flash,
# gemini-3.6-flash, and gemini-flash-latest.
# GEMINI_SEMANTIC_MODEL=

# Seconds a rate-limited key waits before the pool tries it again (default 60).
# GEMINI_KEY_COOLDOWN_SECONDS=60

# Optional Aurochs checkout root for PPTX slide rendering (defaults to vendor/aurochs).
# AUROCHS_ROOT=vendor/aurochs

# Optional base cache directory (defaults to ~/.cache).
# XDG_CACHE_HOME=~/.cache

# Optional .NET OpenXML SDK validator command.
# OPENXML_VALIDATOR_COMMAND=
